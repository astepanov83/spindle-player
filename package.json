{
  "name": "spindle",
  "productName": "Spindle",
  "desktopName": "spindle.desktop",
  "version": "0.1.0",
  "description": "A desktop music player for local files",
  "main": "./out/main/index.js",
  "author": "Alexander Stepanov <alexander.stepanov.v@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/astepanov83/spindle-player",
  "private": true,
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && node scripts/fetch-ffmpeg.mjs --strict && electron-builder --linux",
    "package:win": "npm run build && node scripts/fetch-ffmpeg.mjs --strict && electron-builder --win",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/fetch-ffmpeg.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/svelte-virtual": "^3.13.39",
    "music-metadata": "^11.16.1",
    "strtok3": "^10.3.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
